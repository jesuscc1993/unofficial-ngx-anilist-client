{
  "name": "unofficial-ngx-anilist-client",
  "version": "0.0.0",
  "license": "CC BY-NC 4.0",
  "scripts": {
    "build": "ng build --configuration production --base-href https://jesuscc1993.github.io/unofficial-ngx-anilist-client/",
    "deploy": "yarn release && yarn build && yarn ngh --dir=dist/unofficial-ngx-anilist-client/ && git checkout develop",
    "e2e": "ng e2e",
    "lint": "ng lint",
    "ng": "ng",
    "release": "git checkout develop && git pull && git checkout master && git pull && git merge develop && git push",
    "push-and-deploy": "git push && yarn deploy",
    "start": "ng serve --no-live-reload",
    "test": "ng test",
    "tslint": "tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@ngneat/cashew": "^3.0.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "angular-cli-ghpages": "^1.0.7",
    "angular-eslint": "22.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-jsdoc": "^64.0.0",
    "eslint-plugin-prefer-arrow": "^1.0.0",
    "prettier": "^3.0.0",
    "to-fast-properties": "^3.0.0",
    "tslint": "~6.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "resolutions": {
    "esbuild": "^0.28.1",
    "gh-pages": "^5.0.0",
    "json5": "^2.2.3",
    "negotiator": "^1.0.0",
    "path-to-regexp": "~0.1.12",
    "qs": "^6.15.2",
    "semver": "^7.7.4",
    "send": "^1.1.0",
    "serve-static": "^2.2.0",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.4"
  }
